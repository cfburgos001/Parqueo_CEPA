<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos necesarios -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permisos Bluetooth -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:maxSdkVersion="30" />

    <!-- Características opcionales -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaterialComponents.Light.NoActionBar">

        <!-- Activity de Login (LAUNCHER) -->
        <activity
            android:name="com.cepa.parqueo.LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity Home -->
        <activity
            android:name="com.cepa.parqueo.HomeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Activity Ingreso Vehículo -->
        <activity
            android:name="com.cepa.parqueo.IngresoVehiculoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Activity Salida Vehículo -->
        <activity
            android:name="com.cepa.parqueo.SalidaVehiculoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Activity Pago Vehículo -->
        <activity
            android:name="com.cepa.parqueo.PagoVehiculoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Activity Confirmación de Salida -->
        <activity
            android:name="com.cepa.parqueo.SalidaConfirmacionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Activity Apertura/Cierre -->
        <activity
            android:name="com.cepa.parqueo.AperturaCierreActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Activity Mantenimiento -->
        <activity
            android:name="com.cepa.parqueo.MantenimientoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Activity Gestión de Usuarios -->
        <activity
            android:name="com.cepa.parqueo.GestionUsuariosActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Activity del escáner QR de ZXing -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="screenOrientation" />

        <activity
            android:name=".ConfigurarLogsAperturaActivity"
            android:label="Configurar Logs Apertura"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ConfigurarBarreraActivity"
            android:label="Configurar Barrera"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Reimpresión: hub + búsqueda de ticket + búsqueda de factura -->
        <activity
            android:name=".ReimpresionActivity"
            android:label="Reimpresión"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ReimprimirTicketActivity"
            android:label="Reimprimir Ticket"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ReimprimirFacturaActivity"
            android:label="Reimprimir Factura"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>
</manifest>
