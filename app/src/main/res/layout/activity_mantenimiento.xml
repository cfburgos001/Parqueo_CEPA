<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Mantenimiento"
            app:titleTextColor="@android:color/white"
            android:background="#1976D2"/>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- SECCIÓN: GESTIÓN DE USUARIOS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👥 Gestión de Usuarios"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#0D47A1"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Administrar operadores y usuarios del sistema"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGestionUsuarios"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gestionar Usuarios"
                        app:icon="@android:drawable/ic_menu_manage"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ⭐ NUEVA SECCIÓN: MODO DE COBRO (ESCALONADO/SIN MÁXIMO) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💰 Modo de Cobro (Global)"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#0D47A1"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selecciona el tipo de cobro que aplicará a todos los vehículos"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️ Este cambio afecta a TODOS los POS conectados a la misma base de datos"
                        android:textSize="12sp"
                        android:textColor="#FF9800"
                        android:textStyle="italic"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Modo Sin Máximo:"
                            android:textSize="16sp"
                            android:textColor="#212121"
                            android:textStyle="bold"/>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchModoCobro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEstadoModoCobro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Modo Activo: ESCALONADO"
                        android:textSize="14sp"
                        android:textColor="@android:color/holo_green_dark"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Opciones:\n• APAGADO (Escalonado): Tarifas con tope diario\n• ENCENDIDO (Sin Máximo): Cobro por hora sin límite"
                        android:textSize="12sp"
                        android:textColor="#757575"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ⭐ NUEVA SECCIÓN: TARIFAS ACTUALES -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="💵 Tarifas Actuales"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#0D47A1"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRecargarTarifas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recargar"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            app:icon="@android:drawable/ic_menu_rotate"/>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressBarTarifas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginVertical="16dp"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/tvTarifasActuales"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cargando tarifas..."
                        android:textSize="14sp"
                        android:textColor="#212121"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="4dp"
                        android:visibility="gone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECCIÓN: HABILITAR/DESHABILITAR COBROS EN POS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💳 Configuración de Cobros en POS"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#0D47A1"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Habilitar o deshabilitar la función de cobro en este POS"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️ Nota: La validación de tiempo de gracia siempre permanecerá activa"
                        android:textSize="12sp"
                        android:textColor="#FF9800"
                        android:textStyle="italic"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Habilitar Cobros en POS:"
                            android:textSize="16sp"
                            android:textColor="#212121"
                            android:textStyle="bold"/>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchCobrosPos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEstadoCobrosPos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Este POS puede procesar pagos"
                        android:textSize="14sp"
                        android:textColor="@android:color/holo_green_dark"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Casos de uso:\n• Habilitar: POS cobra directamente\n• Deshabilitar: Solo PayStation (POS solo valida salidas)"
                        android:textSize="12sp"
                        android:textColor="#757575"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECCIÓN: CONFIGURACIÓN DE TIEMPO DE GRACIA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱️ Configuración de Tiempo de Gracia"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#0D47A1"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiempo máximo permitido entre el pago y la salida del vehículo"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiempo de Gracia Actual:"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvTiempoGraciaActual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15 minutos"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTiempoGracia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nuevo Tiempo de Gracia (minutos)"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTiempoGracia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLines="1"
                            android:text="15"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuardarTiempoGracia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Guardar Tiempo de Gracia"
                        app:icon="@android:drawable/ic_menu_save"
                        app:cornerRadius="8dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECCIÓN: CONFIGURACIÓN DE DISPOSITIVO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱 Configuración de Dispositivo"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#0D47A1"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ID del Dispositivo:"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvIdDispositivo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cargando..."
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tipo:"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvTipoDispositivo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MIXTO"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConfigDispositivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Configurar Dispositivo"
                        app:icon="@android:drawable/ic_menu_edit"
                        app:cornerRadius="8dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECCIÓN: CONFIGURACIÓN DEL SERVIDOR -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🖥️ Configuración del Servidor"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#0D47A1"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilServerIp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="IP del Servidor"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etServerIp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilServerPort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Puerto"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etServerPort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLines="1"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDatabaseName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nombre de la Base de Datos"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDatabaseName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDbUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Usuario de la BD"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDbUsername"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDbPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Contraseña de la BD"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:endIconMode="password_toggle"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDbPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:maxLines="1"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuardar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Guardar Configuración"
                        android:textSize="14sp"
                        app:cornerRadius="8dp"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnProbarConexion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Probar Conexión"
                        android:textSize="14sp"
                        app:cornerRadius="8dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestaurar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Restaurar Valores"
                        android:textSize="14sp"
                        app:cornerRadius="8dp"
                        style="@style/Widget.MaterialComponents.Button.TextButton"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>