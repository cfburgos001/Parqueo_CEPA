<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Opciones para registrar la salida del vehículo."
                android:textSize="@dimen/text_body"
                android:textAlignment="center"
                android:textColor="@color/text_primary"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/space_xl" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPlaca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ingresar Placa"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="@dimen/radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/radius_sm"
                app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
                android:layout_marginBottom="@dimen/space_md">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPlaca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrarPorPlaca"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Registrar Salida por Placa"
                android:textAllCaps="false"
                android:textSize="@dimen/text_body"
                app:cornerRadius="@dimen/radius_md"
                android:layout_marginBottom="@dimen/space_lg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/space_lg"
                android:text="O"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEscanearQR"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Escanear Código de Barras o QR"
                android:textAllCaps="false"
                android:textSize="@dimen/text_body"
                app:cornerRadius="@dimen/radius_md"
                android:layout_marginBottom="@dimen/space_xl" />

            <!-- Botón de Pago Sin Cobro (solo visible para CAJA) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSalidaSinCobro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Registrar Pago Sin Cobro"
                android:textAllCaps="false"
                android:textSize="@dimen/text_body"
                app:cornerRadius="@dimen/radius_md"
                app:backgroundTint="@color/status_info"
                android:visibility="gone"
                android:layout_marginTop="@dimen/space_md" />

            <!-- Texto informativo para el botón de cortesía -->
            <TextView
                android:id="@+id/tvInfoSinCobro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Para proveedores y visitas. Solo marca como pagado.\nEl operador debe validar la salida."
                android:textSize="@dimen/text_caption"
                android:textAlignment="center"
                android:textColor="@color/text_secondary"
                android:visibility="gone"
                android:layout_marginTop="@dimen/space_sm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAperturaManualSalida"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_md"
                android:text="Apertura Manual de Barrera"
                android:textAllCaps="false"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_on_primary"
                app:backgroundTint="@color/status_warning"
                app:cornerRadius="@dimen/radius_sm" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
