<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <!-- Card de Información General -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                app:cardBackgroundColor="@color/surface_muted"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/elevation_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="📅 Información del Turno"
                        android:textColor="@color/brand_primary_light"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Fecha:"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvFechaActual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lunes, 14 de enero de 2026"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Operador:"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvOperador"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Juan Pérez"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card de APERTURA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardApertura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:visibility="visible"
                app:cardBackgroundColor="@color/status_success"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/elevation_card_raised">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_xl">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="🔓"
                        android:textSize="48sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_md"
                        android:text="REALIZAR APERTURA DE CAJA"
                        android:textAlignment="center"
                        android:textColor="@color/text_on_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_lg"
                        android:text="Inicia tu turno registrando la apertura de caja"
                        android:textAlignment="center"
                        android:textColor="@color/text_on_primary"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApertura"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="APERTURA DE CAJA"
                        android:textSize="16sp"
                        app:backgroundTint="@color/surface_card"
                        app:cornerRadius="@dimen/radius_md"
                        app:icon="@android:drawable/ic_media_play"
                        app:iconGravity="textStart"
                        android:textColor="@color/status_success" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card de CIERRE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCierre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:visibility="gone"
                app:cardBackgroundColor="@color/status_danger"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/elevation_card_raised">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_xl">

                    <!-- Información de apertura -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_lg"
                        app:cardBackgroundColor="@color/surface_card"
                        app:cardCornerRadius="@dimen/radius_md"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_md">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/space_sm"
                                android:text="✓ Apertura Registrada"
                                android:textColor="@color/status_success"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Hora de Apertura:"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvFechaApertura"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="14/01/2026 08:00"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="🔒"
                        android:textSize="48sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="@dimen/space_md"
                        android:text="REALIZAR CIERRE DE CAJA"
                        android:textAlignment="center"
                        android:textColor="@color/text_on_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="@dimen/space_lg"
                        android:text="Se generará un reporte completo y se cerrará el turno"
                        android:textAlignment="center"
                        android:textColor="@color/text_on_primary"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCierre"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="CIERRE DE CAJA"
                        android:textSize="16sp"
                        app:backgroundTint="@color/surface_card"
                        app:cornerRadius="@dimen/radius_md"
                        app:icon="@android:drawable/ic_media_pause"
                        app:iconGravity="textStart"
                        android:textColor="@color/status_danger"
                        android:layout_marginBottom="@dimen/space_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReporteX"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="📊 REPORTE X (Informativo)"
                        android:textSize="14sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:cornerRadius="@dimen/radius_md"
                        app:strokeColor="@color/text_on_primary"
                        app:strokeWidth="2dp"
                        android:textColor="@color/text_on_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/space_lg"
                android:indeterminateTint="@color/brand_primary"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
